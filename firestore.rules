rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    // 3. Validation Helpers
    function isValidReservation(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.phone is string && data.phone.size() <= 30
        && data.date is string && data.date.size() <= 30
        && data.time is string && data.time.size() <= 30
        && (data.guests is int || data.guests is float) && data.guests >= 1 && data.guests <= 50
        && data.status is string && data.status in ['pending', 'confirmed', 'cancelled'];
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100
        && data.customerEmail is string && data.customerEmail.size() <= 150
        && data.customerPhone is string && data.customerPhone.size() <= 30
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && (data.totalPrice is int || data.totalPrice is float) && data.totalPrice >= 0
        && data.status is string && data.status in ['pending', 'preparing', 'ready', 'completed', 'cancelled'];
    }

    function isValidReview(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (data.rating is int || data.rating is float) && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000
        && (!('tags' in data) || data.tags is list)
        && (!('mealType' in data) || data.mealType is string)
        && (!('ownerResponse' in data) || data.ownerResponse is string);
    }

    // 4. Reservations Collection
    match /reservations/{reservationId} {
      allow get: if true; // Any customer can retrieve their reservation using the exact reservation ID
      allow list: if false; // Deny broad listing to prevent PII harvesting
      
      allow create: if isValidId(reservationId) 
        && isValidReservation(incoming())
        && incoming().status == 'pending'; // New reservations default to pending
        
      allow update: if isValidId(reservationId)
        && isValidReservation(incoming())
        && (
          // Customers can cancel as an explicit state change or developers can trigger simulation updates
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        );
      
      allow delete: if false; // Hard zero-delete policy
    }

    // 5. Orders Collection
    match /orders/{orderId} {
      allow get: if true; // Order receipt lookup by ID
      allow list: if false; // Blanket query block
      
      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().status == 'pending'; // Starts in pending state
        
      allow update: if isValidId(orderId)
        && isValidOrder(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        );
        
      allow delete: if false; // Persistent record policy
    }

    // 6. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Public reviews are completely readable (get and list)
      
      allow create: if isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().createdAt is string
        && incoming().createdAt.size() <= 40;
        
      allow update: if isValidId(reviewId)
        && isValidReview(incoming())
        && (
          // Customers or Simulation Panel can simulate owner responses
          incoming().diff(existing()).affectedKeys().hasOnly(['ownerResponse'])
        );
        
      allow delete: if false;
    }
  }
}
